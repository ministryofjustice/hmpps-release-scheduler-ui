{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "partials/hiddenInputs/macro.njk" import hiddenInputs %}
{% from "partials/simplePagination/macro.njk" import simplePagination %}
{% from "partials/cardTable/macro.njk" import cardTable %}
{% from "partials/statusTag/macro.njk" import statusTag %}

{% set fullScreen = true %}
{% set fullWidth = true %}

{% set caption = 'Schedule and manage releases' if user | hasPermission('MANAGE') else 'View release schedules' %}

{% set pageTitle = 'Search for releases - ' + caption %}

{% if not hasValidationError %}
  {% set searchResultCount = paginationParams.totalRows %}
{% endif %}

{% block innerContent %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">{{ caption }}</span>
        <h1 class="govuk-heading-l">Search for releases</h1>

        <p>Search for an individual prisoner’s release, or filter upcoming releases by date and release status. To search for a prisoner, clear the date range first.</p>
      </div>
    </div>
  </div>

  <div class="block-background govuk-!-padding-top-6 govuk-!-padding-bottom-1 govuk-!-margin-bottom-7">
    <div class="govuk-width-container">
      <search class="moj-search govuk-!-width-two-thirds">
        <form method="GET">
          {{ hiddenInputs(query | getQueryEntries(['history'])) }}
          <div class="search-wrapper moj-search__input-wrapper">
            {{ govukInput({
              name: 'searchTerm',
              classes: "moj-search__input",
              label: {
                text: "Enter prisoner name or prison number."
              },
              value: searchTerm,
              errorMessage: validationErrors | findError('searchTerm')
            }) }}

            {{ govukButton({
              classes: "search-button",
              text: "Search",
              preventDoubleClick: true
            }) }}
          </div>
        </form>
      </search>
    </div>
  </div>

  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter">
        <section role="region" aria-label="Search Filters">
          <form class="hmpps-side-filter" method="GET">
            {{ hiddenInputs(query | getQueryEntries(['history'])) }}
            <h2 class="hmpps-side-filter__header">Filter</h2>
            <div class="hmpps-side-filter__content">
              {{ mojDatePicker({
                id: "start",
                name: "start",
                label: {
                  text: 'Date from'
                },
                hint: { text: 'For example, 17/5/2024.' },
                value: start,
                errorMessage: validationErrors | findError('start'),
                classes: 'hmpps-datepicker--fixed-width'
              }) }}

              {{ mojDatePicker({
                id: "end",
                name: "end",
                label: {
                  text: 'Date to'
                },
                hint: { text: 'For example, 17/5/2024.' },
                value: end,
                errorMessage: validationErrors | findError('end'),
                classes: 'hmpps-datepicker--fixed-width'
              }) }}

              {{ govukCheckboxes({
                id: "status",
                name: "status",
                fieldset: {
                  legend: {
                    text: "Status",
                    classes: "govuk-fieldset__legend--m"
                  }
                },
                classes: "govuk-checkboxes--small",
                errorMessage: validationErrors | findError('status'),
                items: [
                  {
                    value: 'PENDING',
                    text: "Awaiting details"
                  },
                  {
                    value: 'UNVERIFIED',
                    text: "Unverified"
                  },
                  {
                    value: 'VERIFIED',
                    text: "Verified"
                  }
                ] | setCheckedValue(status or '')
              }) }}
            </div>
            {{ govukButton({
              text: "Apply filters",
              preventDoubleClick: true
            }) }}
          </form>
        </section>
      </div>

      <div class="govuk-grid-column-three-quarters">
        {% if hasValidationError %}
          <p class="govuk-!-margin-bottom-6"><strong>Enter a valid filter to search and view releases.</strong></p>
        {% elseif not results.length %}
          <p class="govuk-!-margin-bottom-6"><strong>No releases match your search.</strong></p>
        {% else %}
          <div class="govuk-!-display-none-print govuk-!-margin-bottom-5">
            <form id="sizeForm">
              {{ hiddenInputs(query | getQueryEntries(['searchTerm','start','end','status','history'])) }}
              <label class="govuk-label" for="size">Show results</label>
              <select class="govuk-select hmpps-sort-selector__select" id="size" name="size" value="{{ size }}">
                <option value="10" {{ 'selected' if size == '10' }}>10 per page</option>
                <option value="25" {{ 'selected' if size == '25' }}>25 per page</option>
                <option value="50" {{ 'selected' if size == '50' }}>50 per page</option>
                <option value="100" {{ 'selected' if size == '100' }}>100 per page</option>
              </select>
              <button type="submit" data-prevent-double-click="true" class="govuk-button hmpps-sort-selector__sort-button">
                Reload
              </button>
            </form>
          </div>

          {{ simplePagination(paginationParams) }}

          {% set rows = [] %}
          {% for result in results %}
            {% set rows = (rows.push(
              {
                title: { html: '<a class="govuk-link govuk-link--no-visited-state govuk-!-font-weight-bold" href="' + prisonerProfileBacklink(originalUrl, result.person.identifier) + '">' + result.person | lastNameCommaFirstName + ' - ' + result.person.identifier + '</a>' },
                action: { html: 'View <span class="govuk-visually-hidden"> release for ' + result.person | lastNameCommaFirstName + '</span>', href: ('/schedule-a-release/start/' + result.id) if result.status.code === 'PENDING' else ('/releases/' + result.id)} if result.status.code !== 'PENDING' or user | hasPermission('MANAGE') else null,
                data: [
                result.autoReleaseDate | formatDate("d MMMM yyyy") or 'No data',
                result.approvedReleaseDate | formatDate("d MMMM yyyy") or 'No data',
                result.confirmedReleaseDate | formatDate("d MMMM yyyy") or 'No data',
                { html: statusTag(result, 'float-right shift-right-20') }
              ]
              }
            ), rows) %}
          {% endfor %}

          {{ cardTable({
            columns: [
              [
                { text: 'Auto date', width: 25 },
                { text: 'Approved date', width: 25 },
                { text: 'Confirmed date', width: 25 },
                { text: '', width: 25 }
              ]
            ],
            rows: rows
          }) }}

          {{ simplePagination(paginationParams) }}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
